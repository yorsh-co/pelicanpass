[Unit]
# Re-applies the container egress filter every time the rootless daemon starts.
#
# The rules live in the daemon's own network namespace, so they are destroyed
# whenever it restarts. Without this unit the filter survives exactly until the
# first `systemctl --user restart docker` and then silently stops existing.
#
# A *user* unit, not a system one: the whole control runs as the daemon's own
# user and needs no root. `loginctl enable-linger <user>` is what carries it
# across a reboot (or `wsl --shutdown` on WSL2).
Description=Container egress filter for rootless Docker
After=docker.service
Requires=docker.service

# Tied to the daemon's lifecycle: a stopped daemon means an empty namespace, and
# a restarted one gets the rules re-applied rather than inherited.
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Installed copy, not the repo checkout - the repo may be absent or moved on a
# production host. See the install steps in docs/infrastructure/container-containment.md.
ExecStart=%h/.local/bin/container-egress-filter.sh apply
ExecStop=%h/.local/bin/container-egress-filter.sh flush

# No Restart= here: systemd refuses anything but `no` for Type=oneshot. The
# daemon creates DOCKER-USER during startup and `After=docker.service` only
# waits for the unit rather than for the chain, so the wait for it lives in the
# script instead.

[Install]
WantedBy=default.target
