# Environment for the standalone landing fallback (compose.fallback.yml).
#
# Copy to `.env` on the fallback machine. This file never holds a production
# secret: no database, cache, Turnstile, pass or admin value is read by the
# fallback. See docs/operations/fallback.md.

# Makes a bare `docker compose` target the fallback stack on this machine.
COMPOSE_FILE=compose.fallback.yml

# -----------------------------------------------------------------------------
# Event timing — copy these lines from the production .env unchanged
# -----------------------------------------------------------------------------

# Same meaning and format as production. THE OFFSET IS MANDATORY: the
# container clock is UTC.
EVENT_START_AT=2026-09-13T13:00:00-03:00

# Same meaning and format as production. THE OFFSET IS MANDATORY: the
# container clock is UTC.
EVENT_CLOSES_AT=2026-09-13T23:59:00-03:00

# How long before EVENT_START_AT each audience may check in. Defaults: 30m, 4h.
CHECKIN_OPENS_BEFORE_PARTICIPANT=30m
CHECKIN_OPENS_BEFORE_VOLUNTEER=4h

EVENT_TIMEZONE=America/Sao_Paulo

APP_TITLE=PelicanPass

# -----------------------------------------------------------------------------
# Tunnel
# -----------------------------------------------------------------------------

# Token of the dedicated fallback tunnel — NOT production's TUNNEL_TOKEN.
TUNNEL_TOKEN=your-fallback-tunnel-token

TUNNEL_LOGLEVEL=warn

LOG_LEVEL=info
