# -----------------------------------------------------------------------------
# Compose
# -----------------------------------------------------------------------------

# Which compose file `docker compose` uses when no -f flag is given.
#
# Leave empty in development: a bare `docker compose` then resolves compose.yml,
# so production never starts by accident.
#
# Set to compose.prod.yml on a production host. Compose reads this from .env
# rather than only from the shell, so systemd units, cron jobs and other admins'
# sessions all target the same stack. An explicit -f still overrides it.
#
# Separate multiple files with ":".
# Optional. See docs/operations/deployment.md.
#COMPOSE_FILE=compose.prod.yml

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
#
# Leave both commented out. Each compose file carries its own default, and the
# two defaults differ so the development and production stacks can run on one
# host at the same time:
#
#                 EDGE_SUBNET      VPN_IP
#   compose.yml   172.31.0.0/24    172.31.0.250
#   prod          172.30.0.0/24    172.30.0.250
#
# Override only when the host already holds the default range. Check with the
# one-liner in docs/operations/deployment.md, under "The stack".
#
# These are a trust boundary, not just addressing. The Caddyfile accepts a
# client IP from any address in EDGE_SUBNET, and admin traffic from VPN_IP
# alone. An override must keep to all of the following:
#
#   - EDGE_SUBNET holds the edge network and nothing else. Never widen it to
#     cover the web network: 172.16.0.0/12, for one, would let the app
#     container choose its own rate-limit key.
#   - VPN_IP sits inside EDGE_SUBNET, high in the range, clear of the addresses
#     Docker hands out from the bottom. One outside the subnet stops the vpn
#     container from starting.
#   - A development and a production stack on the same host never share a
#     range.
#
# Set but empty is treated as unset, so the default applies.
#
# Default: per compose file, as above.
#EDGE_SUBNET=172.30.0.0/24
#VPN_IP=172.30.0.250

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Port the app listens on inside the container.
# Default: 3000
PORT=3000

# Node environment.
# Accepts: 'development' | 'production'
# Default: 'production'
NODE_ENV=production

# Log verbosity.
# Accepts: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
# Default: 'info'
#
# This gates before the per-destination levels below do, so setting it to 'error'
# silences the durable file as well as stdout.
LOG_LEVEL=info

# Directory for the rotating log file that carries `warn` and above.
#
# Everything goes to stdout, which Docker rotates and then discards with the
# container — a `--force-recreate` mid-event takes the evening's history with it.
# `warn` and above additionally goes here, on the `logs` volume, which survives a
# recreate and is the record archived at teardown.
#
# Not gated on NODE_ENV — development gets the same file, so the feature is
# exercised before the night it has to work. The value below is repo-relative and
# lands in a gitignored ./logs, which the dev bind mount surfaces on the host.
#
# Production must set this to '/var/log/pelicanpass', matching the `logs` volume
# mount in compose.prod.yml. Leaving it repo-relative there fails at boot rather
# than quietly: the container is read_only everywhere except that mount.
#
# Leave empty to disable the file entirely.
#
# Holds IPs and actor ids, so it is inventoried in docs/security/data-retention.md and is
# destroyed with the rest of the event's data.
#
# Default: '' (disabled)
LOG_FILE_DIR=logs

# Discord webhook for operational alerts. Empty disables delivery without
# disabling the rules, which still log — which is what you want in development
# and during a rehearsal, where the rule firing is the thing under test.
#
# Alerts carry no personal data: a fingerprint, an error code, a route, counts
# and a request id. The field names on docs/security/data-retention.md's list are
# censored at the egress boundary rather than trusted to each call site.
#
# Default: '' (no delivery)
DISCORD_WEBHOOK_URL=

# Optional second webhook for `critical` only. Worth pointing at a channel with
# notifications on: the critical rules are the ones that should reach a phone at
# 20:00, and the warnings are the ones that should not. Falls back to the
# webhook above when empty.
#
# Default: '' (use DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_URL_CRITICAL=

# Master switch for alert delivery. Rules still evaluate and log when false.
# Default: true
ALERT_ENABLED=true

# How long one alert signature stays suppressed after a message goes out.
# Repeats inside the window are counted, not dropped, and the next message says
# how many it stood for.
#
# Accepts a duration like '90s', '10m', '4h'.
# Default: '10m'
ALERT_DEDUP_TTL=10m

# Load shedding. Public requests are answered 503 with Retry-After instead of
# queueing: all of them while the event loop has lagged for a second, and
# otherwise only those arriving while the Postgres queue is over its limit.
# Admin routes, /healthz, /readyz and static files are never shed.
# Default: true
LOAD_SHED_ENABLED=true

# Worst event-loop stall (p99 over each half-second window), in milliseconds.
# A second above it sheds every public request, until five seconds below it.
# Default: 250
LOAD_SHED_MAX_LAG_MS=250

# Requests queued for a Postgres connection. Checked on each request: one that
# arrives while the queue is longer than this is shed, and the rest are served.
# The pool holds 10 connections.
# Default: 20
LOAD_SHED_MAX_POOL_WAITING=20

# Seconds a shed client is told to wait before retrying.
# Default: 5
LOAD_SHED_RETRY_AFTER_SECONDS=5

# How long a row survives in app_events before the retention sweep removes it.
#
# On event day this never fires: the host is destroyed roughly 24 hours after
# the event and the default is 72. It is here so the table is bounded by the
# code rather than by the teardown schedule, which matters on a host reused
# across events.
#
# Accepts a duration like '90s', '10m', '4h'.
# Default: '72h'
TELEMETRY_EVENT_RETENTION=72h

# Display name shown in the app UI.
# Default: 'PelicanPass'
APP_TITLE='PelicanPass'

# Public URL the app is served from.
# Required.
APP_URL=https://yourapp.com

# Hostname the public vhost answers on. This is the host half of APP_URL, and
# the two must agree: APP_URL drives the app's same-origin check, SITE_HOST
# drives which Host header Caddy will answer at all. A disagreement surfaces as
# a 404 from Caddy on every request, or as a rejected state-changing request,
# depending which of the two is wrong.
#
# A bare hostname — no scheme, no path, no port. 'yourapp.com', never
# 'https://yourapp.com'. Caddy's Caddyfile adapter substitutes it as plain text
# into a site address that already carries its own `http://`.
#
# Read only by Caddyfile, through the `proxy` service in both compose files.
# It exists so the same Caddyfile serves development and production without an
# edit — it is the one value in that file that differs between them.
#
# Required, and enforced by compose rather than by Caddy: both files declare it
# `${SITE_HOST:?...}`, so an unset or empty value stops `docker compose` before
# anything starts. Caddy cannot catch it — an empty substitution leaves the site
# address as `http://`, which is a valid catch-all on :80 and would answer any
# Host header.
#
# Changing it needs the container recreated, not just restarted —
# `docker compose up -d --force-recreate proxy`. Caddy reads the environment
# once, at config load, so a `restart` or a `caddy reload` keeps the old value.
SITE_HOST=yourapp.com

# Names the machine this stack runs on, in the proxy's internal status response
# (`http://proxy`). Lower-case letters, digits and dashes; use the same label as
# the load test's --host, so one name means one machine everywhere.
#
# Read only by Caddyfile, through the `proxy` service in both compose files.
# Optional: unset reads as "unnamed". Changing it needs the proxy recreated,
# as for SITE_HOST above.
SERVER_NAME=your-server

# Addresses that get the relaxed rate-limit tier, so the whole venue sharing one
# NAT address does not exhaust a budget meant for a single client.
#
#                /api/v1    GET /checkin    web routes
#   untrusted     300/min        60/min        300/min
#   trusted      2000/min       600/min       1000/min
#
# Comma-separated. Each entry is either a bare address or a CIDR range, IPv4 or
# IPv6 — `203.0.113.7, 198.51.100.0/24, 2001:db8::/32`. Matching is by subnet,
# so a range covers every address inside it.
#
# Optional; empty means everyone gets the strict tier.
TRUSTED_IPS=

# Rate-limit quota overrides, applied on top of src/config/rate-limits.ts.
#
# Comma-separated `prefix=points/duration`, keyed by the Redis prefix the
# metrics panel shows — `rl:ip=600/60, rl:ip:web:trusted=2000/60`. Duration is
# in seconds; a limiter's block duration is not overridable. An unknown prefix
# or malformed entry fails at boot, and active overrides are logged as a warning.
# Apply with `docker compose up -d --force-recreate app`, not `restart`.
#
# Optional; empty means every default applies.
RATE_LIMIT_OVERRIDES=

# Identifier of the event this deployment serves check-ins for.
#
# Every attendee query filters on it, so a row whose `event_id` column holds
# anything else is invisible to this deployment — it behaves exactly like an
# unknown ticket, with no error distinguishing the two. Inserts must name the
# column; it is NOT NULL with no default.
#
# Changing it after go-live orphans every existing attendee. Treat it as fixed
# once the roster is loaded.
#
# Required. Format: ^[A-Za-z0-9][A-Za-z0-9._:-]*$ — a UUID is the intended
# shape. Enforced by migrations/006_event-scoping.ts, which backfills existing
# rows with this value and throws if it is unset.
EVENT_ID=uuid

# Token embedded in the venue poster QR codes. A scan is accepted only when it
# carries this exact value. Print the poster URLs with `npm run qr:urls`.
#
# Changing it after the posters are printed means reprinting them: every code
# already on a wall stops working.
#
# Required. Format: ^[a-zA-Z0-9]{10,32}$ — generate with `openssl rand -hex 16`.
# Not the 32-byte shape of the secrets below: 64 characters is too long. Enforced
# at boot by src/config/env.ts, in every environment, so the placeholder below
# fails until it is replaced.
CHECKIN_QR_TOKEN=run-openssl-rand-hex-16

# Key the rotating band and the per-attendee pass token are derived from.
#
# Required. Format: ^[0-9a-fA-F]{64,}$ — generate with `openssl rand -hex 32`.
# Enforced at boot by src/config/env.ts, in every environment, so the
# placeholder below fails until it is replaced.
PASS_SECRET=run-openssl-rand-hex-32

# Whether the pass carries the rotating band — the colour-and-word pair the
# attendee's screen and the volunteer's own show independently and compare by
# eye.
#
# Optional. "true" or "false", default true.
#
# This does NOT affect scanning. A scanned pass is settled entirely by its
# signed token, which is checked, bounded to its window and spent on first use
# whatever this is set to. What "false" gives up is the eyes-only check: when
# the camera will not open and the volunteer falls back to the ticket code,
# that code is printed on the pass and never rotates, so nothing but the band
# distinguishes a live pass from a photograph of one. Both screens keep a clock,
# which shows liveness but — unlike the band — can be produced by anything able
# to run a timer.
#
# Turn it off only where every station scans, or where the comparison is not in
# the volunteer briefing and is therefore not happening anyway.
PASS_BAND_ENABLED=true

# The language of the band's word: `pt-BR` or `en`. One value for the whole
# event, whatever language each person reads the page in, because the attendee's
# pass and the volunteer's screen are compared by eye and must show the same
# word. Pick the language most of your volunteers read aloud; the colour is not
# affected. The lists are in src/constants/pass.ts. Defaults to pt-BR.
# PASS_BAND_LANGUAGE=pt-BR

# When the welcome line under the attendee's name switches text, as a
# comma-separated list of phase@instant in ascending order. Each phase is a case
# of `pass.welcome` in src/i18n/messages/pt-BR/pass.json, which holds its text:
# arrival, default, survey or thanks. Passes show arrival before the first
# entry, and a phase may appear again, e.g. arrival on the second morning.
#
# survey is settled per attendee: thanks once they have answered the
# questionnaire, default while it is not open to them.
#
# Open passes pick up a switch within 30 seconds. Volunteers with a team see
# their team there instead, whatever the phase. Apply a change with
# `docker compose up -d --force-recreate app`: a `restart` keeps the old value.
#
# This is the DEFAULT. A schedule saved at /admin/pass (scope `pass:write`)
# replaces it until an administrator presses "Voltar ao .env" there, so
# changing this value has no visible effect while one is saved. On the day,
# prefer the screen: it needs no shell and no recreate.
#
# THE OFFSET IS MANDATORY, for the reason given under EVENT_START_AT. Boot
# refuses a value without one, an unknown phase, or entries out of order.
#
# Default: empty, arrival for the whole event
# Example: default@2026-10-03T13:00:00-03:00,survey@2026-10-03T18:00:00-03:00
PASS_WELCOME_SCHEDULE=

# Pepper mixed into every administrator password before it is hashed.
#
# This is the half of an admin password that does NOT live in Postgres. The
# application role can read `admins.password_hash`, so a SQL injection or a
# leaked dump yields every hash and every salt — and neither is worth anything
# without this value. It is what makes a database-only compromise a dead end.
#
# BACK THIS UP, alongside PASS_SECRET.
#
#   - Losing it locks out every administrator. Nothing can re-derive a hash
#     without the original password, so recovery means setting each password
#     again with scripts/admin/set-admin-password.ts.
#   - Changing it has exactly the same effect, so treat a rotation as a planned
#     reset for everyone, not a config tweak.
#
# Must be a DIFFERENT value from PASS_SECRET — generate its own. The two protect
# different things, and sharing one would mean rotating either silently broke
# the other. Boot refuses if they match.
#
# Required. Format: ^[0-9a-fA-F]{64,}$ — generate with `openssl rand -hex 32`.
# Enforced at boot in every environment, so the placeholder below fails until it
# is replaced.
ADMIN_PASSWORD_PEPPER=run-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Pre-event landing page
# -----------------------------------------------------------------------------

# Whether the landing page stands in front of the app until check-in opens.
#
# While it is on, anyone without an attendee session who opens `/`, `/pass`,
# `/checkin`, `/staff` or `/raffle` gets a welcome page and a countdown instead.
# `/admin`, `/privacy` and `/terms` are never covered, and neither is anything
# under `/api/v1` except the check-in endpoints, which refuse early attempts.
#
# Off by default so development and testing never meet a curtain. Turning it on
# is a deliberate act, and turning it back off is how you test the flow before
# the event.
#
# Default: false
LANDING_ENABLED=false

# When the event begins. Both check-in windows are measured back from it, so
# moving the event moves them together.
#
# THE OFFSET IS MANDATORY. Neither compose file sets `TZ`, so the container runs
# UTC and `2026-09-13T19:00:00` would be read three hours off Sao Paulo time —
# a window that opens in the wrong part of the afternoon, discovered by the
# queue. Boot refuses a value without one.
#
# Required when LANDING_ENABLED=true, ignored otherwise.
EVENT_START_AT=2026-09-13T13:00:00-03:00

# Post-event closing page. From this instant every public page shows the
# thank-you page and the attendee API answers 410 EVENT_CLOSED; /admin stays
# open for the teardown. Optional; needs an explicit UTC offset. Must not be
# before SURVEY_CLOSES_AT, and must be after EVENT_START_AT.
# Keep it identical in the production and fallback .env.
EVENT_CLOSES_AT=2026-09-14T23:59:00-03:00

# How long before EVENT_START_AT each audience may check in. Volunteers open
# first: they are the ones setting the room up.
#
# Format: a count and a unit, one of `s`, `m` or `h`. Boot refuses anything
# else — `240` is not four hours, and this file gets edited under pressure.
#
# Default: 30m
CHECKIN_OPENS_BEFORE_PARTICIPANT=30m
# Default: 4h
CHECKIN_OPENS_BEFORE_VOLUNTEER=4h

# Timezone the landing page prints the absolute open time in. Explicit because
# the container is UTC and the page is read in Sao Paulo. An unknown zone fails
# the boot rather than silently falling back.
#
# Default: America/Sao_Paulo
EVENT_TIMEZONE=America/Sao_Paulo

# Optional smoke-test key. When set, `?preview=<token>` opens the real check-in
# flow during a closed window without flipping LANDING_ENABLED off for everyone.
# It is exchanged for a two-hour cookie and dropped from the URL.
#
# Leave it EMPTY for the event. A key that is still set on the day is a way past
# the curtain that nobody is tracking.
#
# Default: unset (no bypass exists)
LANDING_BYPASS_TOKEN=

# -----------------------------------------------------------------------------
# Experience questionnaire
# -----------------------------------------------------------------------------

# Whether each audience is offered the questionnaire on its pass. One switch per
# audience, so either form can be turned off without touching the other.
#
# The questions themselves are src/web/content/pt-BR/survey-participant.md and
# survey-volunteer.md; see docs/development/copy-management.md. A drafted volunteer file is
# safe to commit with its switch off: `npm run check` validates it either way.
# Turning SURVEY_VOLUNTEER_ENABLED on without that file stops the boot.
#
# Default: false
SURVEY_PARTICIPANT_ENABLED=false
# Default: false
SURVEY_VOLUNTEER_ENABLED=false

# When the questionnaire opens and, optionally, closes. One schedule for both
# audiences. The override on /admin/survey beats it either way, for both at
# once, but never opens an audience whose switch above is off.
#
# To open by hand only, set SURVEY_OPENS_AT far in the future and use the
# override.
#
# THE OFFSET IS MANDATORY, for the reason given under EVENT_START_AT. Boot
# refuses a value without one, and a SURVEY_CLOSES_AT that is not after
# SURVEY_OPENS_AT.
#
# SURVEY_OPENS_AT is required when either switch is true, and both are ignored
# while both are false. SURVEY_CLOSES_AT is optional: unset, the questionnaire
# stays open until an administrator closes it.
SURVEY_OPENS_AT=2026-09-13T21:00:00-03:00
SURVEY_CLOSES_AT=

# -----------------------------------------------------------------------------
# Session TTLs (seconds)
# -----------------------------------------------------------------------------

# Check-in session lifetime.
# Default: 600 (10 minutes)
CHECKIN_SESSION_TTL=900

# Attendee session lifetime.
#
# With a questionnaire switched on and SURVEY_CLOSES_AT set, this must cover the
# span from the earliest switched-on audience's check-in opening to
# SURVEY_CLOSES_AT, or boot refuses: the pass does not refresh the session, and
# an attendee whose session lapses cannot answer.
#
# Default: 3600 (1 hour)
ATTENDEE_SESSION_TTL=86400

# Admin session lifetime.
# Default: 3600 (1 hour)
ADMIN_SESSION_TTL=3600

# Ceiling on an admin session, however active it is.
#
# The TTL above slides — every request refreshes it — so a tab left open never
# ages out on its own. This ends the session regardless, counted from sign-in.
# Only admin sessions carry one: they are the only kind that exists to change
# data on purpose.
#
# Optional. Format: a duration like "30m", "12h" or "90s".
# Default: 12h
ADMIN_SESSION_MAX_AGE=12h

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
#
# Four separate credentials, each with a different job. The split exists because
# a single POSTGRES_USER cannot do both of the first two: it is the name the
# postgres image creates its superuser under, AND the name the application
# connects as. Merging them makes the application a superuser, which hands any
# SQL injection COPY … FROM PROGRAM — remote code execution on the database
# host.
#
#   POSTGRES_SUPERUSER   Initialises the container. Nothing connects with it at
#                        runtime; it exists to create the other three and to
#                        take pg_dump backups.
#   POSTGRES_USER        What the application connects as. Non-superuser, no
#                        DDL, and granted only the columns of `attendees` it
#                        actually reads or writes.
#   POSTGRES_MIGRATOR_*  Owns the schema and runs `npm run migrate`. Never
#                        reaches the running application.
#   POSTGRES_READONLY_*  Plain SELECT, for psql / DBeaver / lazysql sessions.
#
# The last three are created by scripts/db/init/01-roles.sh, which the database
# container runs from /docker-entrypoint-initdb.d on a freshly initialised data
# directory. On a volume that already exists it never fires — run it by hand:
#
#   docker compose exec db sh /docker-entrypoint-initdb.d/01-roles.sh
#
# It is idempotent, and it re-applies passwords on every run, so that is also
# how you rotate one. See docs/operations/db-cheatsheet.md.
#
# ---- Value formats -----------------------------------------------------------
#
# Role names (the three *_USER values) must match ^[a-z_][a-z0-9_]*$ — lowercase
#   letters, digits and underscores, not starting with a digit. They are
#   interpolated into SQL as bare identifiers. Enforced by 01-roles.sh, and
#   again by migrations/005_app-role-grants.ts for POSTGRES_USER
#   and by migrations/020_survey.ts for POSTGRES_READONLY_USER.
#
# Role passwords (POSTGRES_PASSWORD, POSTGRES_MIGRATOR_PASSWORD,
#   POSTGRES_READONLY_PASSWORD) must match ^[A-Za-z0-9]{12,}$ — alphanumerics
#   only, at least 12 characters. No punctuation: `npm run migrate` assembles a
#   DATABASE_URL by string interpolation, so '@', ':', '/', '#' and '?' break
#   it. Enforced by 01-roles.sh, which stops before creating anything.
#
#   Generate with: openssl rand -hex 24
#
# POSTGRES_SUPERUSER_PASSWORD is not format-checked — it never appears in a URL
#   — but use the same shape for consistency.
#
# ---- Changing these on an existing database ----------------------------------
#
# POSTGRES_SUPERUSER and POSTGRES_SUPERUSER_PASSWORD are read by the postgres
# image only while it initialises an empty data directory. Editing them later
# does not rename the superuser or change its password; it just makes this file
# disagree with the database. Set them to whatever the volume was created with.
#
# The other three take effect the next time 01-roles.sh runs.

# Required. Hostname of the Postgres service (matches the docker-compose service name).
POSTGRES_HOST=db

# Default: 5432
POSTGRES_PORT=5432

# Required. Database name. Free-form; quoted wherever it reaches SQL.
POSTGRES_DB=pelicanpass

# Required. Bootstrap superuser for the database container. Compose maps this
# onto the image's own POSTGRES_USER, which is the name it insists on.
# Format: ^[a-z_][a-z0-9_]*$
POSTGRES_SUPERUSER=postgres

# Required. Only applied when the data directory is first created.
POSTGRES_SUPERUSER_PASSWORD=change-me

# Required. The role the application connects as — this is the one env.ts reads.
# Format: ^[a-z_][a-z0-9_]*$
POSTGRES_USER=pelicanpass_app

# Required. Format: ^[A-Za-z0-9]{12,}$. In production env.ts additionally rejects
# known-weak values (e.g. 'postgres', 'password', 'changeme').
POSTGRES_PASSWORD=change-me

# Required. Schema owner. Used by `npm run migrate` and nothing else.
# Format: ^[a-z_][a-z0-9_]*$
POSTGRES_MIGRATOR_USER=pelicanpass_migrator

# Required. Format: ^[A-Za-z0-9]{12,}$
POSTGRES_MIGRATOR_PASSWORD=change-me

# Required. Read-only browsing credential. `npm run migrate` also reads the name,
# to withhold tables from this role that it would otherwise read by default.
# Format: ^[a-z_][a-z0-9_]*$
POSTGRES_READONLY_USER=pelicanpass_readonly

# Required. Format: ^[A-Za-z0-9]{12,}$
POSTGRES_READONLY_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Required. Hostname of the Redis service (matches the docker-compose service name).
REDIS_HOST=cache

# Default: 6379
REDIS_PORT=6379

# Required. In production, must be at least 12 characters and not a known-weak/default value (e.g. 'postgres', 'password', 'changeme').
REDIS_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (CAPTCHA)
# -----------------------------------------------------------------------------

# Required.
TURNSTILE_SITE_KEY=your-site-key

# Required.
TURNSTILE_SECRET=your-secret-key

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — administrator sign-in
# -----------------------------------------------------------------------------
# A second widget, not the attendee one. Turnstile keys carry their own hostname
# allowlist, and the sign-in form answers on both the public hostname and the
# tailnet one while both paths stand. Details: docs/infrastructure/cloudflare-rules.md.
#
# The values below are Cloudflare's documented always-pass test keys, which is
# what development wants. Replace both in production.

# Required.
TURNSTILE_ADMIN_SITE_KEY=1x00000000000000000000AA

# Required.
TURNSTILE_ADMIN_SECRET=1x0000000000000000000000000000000AA

# Default: true. Set false to stop enforcing the check without removing the
# widget — the escape hatch for a Turnstile outage during an event, since a
# failed verification is indistinguishable from a refused one. Leaves sign-in
# standing on Cloudflare Access and the password alone, so put it back.
TURNSTILE_ADMIN_ENFORCE=true

# -----------------------------------------------------------------------------
# Cloudflare Access (administrator surface)
# -----------------------------------------------------------------------------
# The origin verifies the Access assertion itself rather than trusting that the
# edge policy is still pointed at the right hostname and path. Details:
# docs/infrastructure/cloudflare-rules.md.
#
# Both are optional, and while either is empty every request that did not arrive
# over the tailnet is refused — which is what makes the window between deploying
# the gate and creating the Access application fail closed. Leave them unset
# until the application exists.

# Optional. The full team hostname, which is both the JWKS host and the token's
# `iss` claim. Example: yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=

# Optional. The Access application's Audience (AUD) tag. The check that matters:
# anything else behind Access on the same team domain has a valid signature and
# a valid issuer, and only this tells those tokens apart from ours.
CF_ACCESS_AUD=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Sends the entry link to the roster, and receives delivery receipts back.
# Setup, dashboard steps and troubleshooting: docs/features/whatsapp-integration.md.

# Master switch for sending. When true, WHATSAPP_PHONE_NUMBER_ID and
# WHATSAPP_ACCESS_TOKEN must both be set or the app refuses to boot — a
# half-configured sender would otherwise fail at message one, mid-run.
# Default: false
WHATSAPP_ENABLED=false

# Meta's internal id for the business phone number — not the number itself.
# WhatsApp Manager -> Account tools -> Phone numbers.
# Required when WHATSAPP_ENABLED is true.
WHATSAPP_PHONE_NUMBER_ID=

# Authorises our outbound calls to the Graph API.
#
# It must be a System User token, from Business Settings. A user token or a
# page token expires, and the expiry ends a run mid-flight with error 190 rather
# than at a convenient moment.
#
# A long-lived secret, to back up alongside PASS_SECRET and
# ADMIN_PASSWORD_PEPPER. Unlike those two it authorises a third party's API on
# the church's WhatsApp number, so losing it is a different kind of problem from
# losing a signing key.
#
# Required when WHATSAPP_ENABLED is true.
WHATSAPP_ACCESS_TOKEN=

# Graph API version the client calls.
#
# Configurable so that a version deprecation is a .env edit on the night rather
# than a deploy.
#
# Default: 'v25.0'
WHATSAPP_GRAPH_VERSION=v25.0

# Country code prepended to 10- and 11-digit stored numbers during E.164
# normalisation. Numbers that already carry it are passed through; nothing else
# is repaired.
# Default: '55' (Brazil)
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Milliseconds between messages. One message per tick, so this is the pacing.
#
# 1000 and not the 12 the published rate limit would allow: the binding
# constraint is the quality rating rather than throughput, and a burst that
# reads as automated costs the number its tier. A bare count rather than a
# duration like '1s', because the unit is milliseconds and sub-second pacing has
# to stay expressible.
#
# Default: 1000
WHATSAPP_SEND_INTERVAL_MS=1000

# How long one Graph API call may take before it is aborted.
#
# Accepts a duration like '90s', '10m', '4h'.
# Default: '10s'
WHATSAPP_REQUEST_TIMEOUT=10s

# How many times a transient failure is retried before the row is failed.
# Default: 3
WHATSAPP_MAX_ATTEMPTS=3

# Lock on the door message: the template sent to an attendee created by hand in
# /admin/attendees. When false, door messages are off whatever the switch on the
# roster says, and no administrator can turn them on from the application. When
# true, that switch decides, and it starts off.
#
# Needs WHATSAPP_ENABLED=true as well. When true, WHATSAPP_DOOR_TEMPLATE,
# WHATSAPP_DOOR_TEMPLATE_VOLUNTEER and WHATSAPP_BUDGET_USD must all be set or
# the app refuses to boot.
#
# Default: false
WHATSAPP_DOOR_ENABLED=false

# Registry key of the template a door message sends to participants, as listed
# in src/constants/whatsapp-templates.ts. The app refuses to boot if it names no
# entry, or one that is not offered to the participant role.
# Example: pax_door_v1:pt_BR
# Required when WHATSAPP_DOOR_ENABLED is true.
WHATSAPP_DOOR_TEMPLATE=

# Registry key of the template a door message sends to volunteers. The app
# refuses to boot if it names no entry, or one that is not offered to the
# volunteer role. Set both to the same key when one template suits both roles.
# Example: vol_door_v1:pt_BR
# Required when WHATSAPP_DOOR_ENABLED is true.
WHATSAPP_DOOR_TEMPLATE_VOLUNTEER=

# The event's WhatsApp budget, in US dollars.
#
# A door message is sent only while every message Meta has accepted for this
# event — bulk runs from /admin/whatsapp included — plus this one, priced at
# TEMPLATE_PRICE_USD, still fits. Meta bills delivered messages only, so this is
# an upper bound and cannot be overshot by door messages. Bulk runs are counted
# but never stopped by it. For a safety margin, set it lower.
#
# Required when WHATSAPP_DOOR_ENABLED is true.
WHATSAPP_BUDGET_USD=

# Master switch for receiving delivery receipts. Separate from WHATSAPP_ENABLED
# because sending and receiving fail independently: sending without a registered
# callback is a valid state, not a broken one.
#
# When true, the three values below must all be set or the app refuses to boot.
# A missing one would surface as a silent 403 back to Meta, which retries with
# decreasing frequency for up to seven days while nothing here reports a fault.
#
# Default: false
WHATSAPP_WEBHOOK_ENABLED=false

# The key Meta signs inbound webhook bodies with, verified as an HMAC-SHA256
# over the raw request body. It is the entire boundary on a publicly reachable
# route.
#
# This is NOT WHATSAPP_ACCESS_TOKEN. They are both "the WhatsApp secret" in
# conversation and they are different credentials from different screens: this
# one is Meta App -> Settings -> Basic. Using the access token here fails as a
# 403 on every receipt, with nothing else visibly wrong.
#
# Required when WHATSAPP_WEBHOOK_ENABLED is true.
WHATSAPP_APP_SECRET=

# Echoed back during Meta's GET verification handshake.
#
# A value we choose rather than one Meta issues: generate with
# `openssl rand -hex 32`. It has to match in two places — here, and the callback
# configuration in the Meta App dashboard.
#
# Required when WHATSAPP_WEBHOOK_ENABLED is true.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# The last segment of the callback path.
#
# Noise reduction, not a control. It keeps opportunistic scanners out of the
# logs; the HMAC above is what actually refuses a forged request. Never skip the
# signature check because this value is hard to guess.
#
# Generate with `openssl rand -hex 32`. It has to match in three places — here,
# the callback URL registered with Meta, and the two Cloudflare expressions in
# docs/infrastructure/cloudflare-rules.md.
#
# Required when WHATSAPP_WEBHOOK_ENABLED is true.
WHATSAPP_WEBHOOK_PATH_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# -----------------------------------------------------------------------------

# Required only if deploying via cloudflare/cloudflared.
TUNNEL_TOKEN=your-tunnel-token

# Log verbosity.
# Accepts: 'fatal' | 'error' | 'warn' | 'info' | 'debug'
# Required.
TUNNEL_LOGLEVEL=warn

# -----------------------------------------------------------------------------
# Tailscale Sidecar
# -----------------------------------------------------------------------------
# Access the admin interface over a private tailnet.

# URL the admin routes answer on, which is the sidecar's own name on the
# tailnet. The same-origin check accepts it as a second origin alongside
# APP_URL.
# Required only if deploying the tailscale sidecar. The app boots without it,
# but every state-changing admin request arriving over the tailnet is then
# rejected as cross-origin.
ADMIN_URL=https://your-hostname.your-tailnet.ts.net

# Registers the sidecar on the tailnet. Generate a tagged key in the Tailscale
# admin console.
# Required on first registration only. The node keeps its identity in the `vpn`
# volume, so later starts ignore this — it is needed again only if that volume
# is recreated.
TS_AUTHKEY=your-auth-key

# Name the sidecar answers to on the tailnet, and the host half of ADMIN_URL
# above.
# Required only if deploying the tailscale sidecar. Compose passes this straight
# to `hostname:`, so leaving it unset gives the container an empty hostname
# rather than a generated one.
TS_HOSTNAME=your-hostname
