{
  "name": "pelicanpass",
  "version": "2.1.0",
  "private": true,
  "description": "In-person conference experience web app with participant-initiated check-in, attendee passes and volunteer tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/pelicanpass"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.0",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.2.0",
    "intl-messageformat": "12.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.12",
    "marked": "^18.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "qrcode-generator": "^2.0.4",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "6.16.29",
    "@formatjs/icu-messageformat-parser": "3.5.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/fontkit": "^2.0.9",
    "@types/k6": "^2.2.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^8.0.0",
    "echarts": "6.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "fontkit": "^2.0.4",
    "globals": "^17.9.0",
    "html5-qrcode": "^2.3.8",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "node src/server.ts",
    "fallback": "node src/fallback/server.ts",
    "dev": "concurrently -n client,server,i18n -c cyan,green,magenta \"npm:dev:client\" \"npm:dev:app\" \"npm:dev:i18n\"",
    "dev:app": "node --watch --watch-kill-signal=SIGUSR2 src/server.ts",
    "dev:client": "npm run i18n:build && node scripts/build-client.ts --watch",
    "dev:https": "npm run dev:compose",
    "dev:compose": "docker compose up",
    "migrate": "sh -c 'DATABASE_URL=postgres://$POSTGRES_MIGRATOR_USER:$POSTGRES_MIGRATOR_PASSWORD@$POSTGRES_HOST:5432/$POSTGRES_DB node-pg-migrate up'",
    "migrate:down": "sh -c 'DATABASE_URL=postgres://$POSTGRES_MIGRATOR_USER:$POSTGRES_MIGRATOR_PASSWORD@$POSTGRES_HOST:5432/$POSTGRES_DB node-pg-migrate down'",
    "dev:migrate": "dotenv -- npm run migrate",
    "dev:migrate:down": "dotenv -- npm run migrate:down",
    "dev:seed": "dotenv -- node scripts/db/seed.ts",
    "dev:import": "dotenv -- node scripts/db/import-attendees.ts",
    "codes": "node scripts/db/generate-ticket-codes.ts",
    "dev:permissions": "dotenv -- node scripts/db/set-volunteer-permissions.ts",
    "build": "node scripts/build-client.ts --prod",
    "build:static": "npm run build && node scripts/static/build.ts",
    "build:demo": "npm run build && node scripts/demo/build.ts",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:frontend-tests && npm run typecheck:loadtest && npm run typecheck:report",
    "typecheck:backend": "tsc -p tsconfig.json",
    "typecheck:frontend": "tsc -p src/web/client/tsconfig.json",
    "typecheck:frontend-tests": "tsc -p src/web/client/tsconfig.test.json",
    "typecheck:loadtest": "tsc -p loadtest/tsconfig.json",
    "typecheck:report": "tsc -p scripts/report/page/tsconfig.json",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import ./src/test/setup-env.ts --test 'src/**/*.test.ts' 'scripts/**/*.test.ts' 'loadtest/**/*.test.ts'",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run i18n:check && npm run i18n:inventory:check && npm run i18n:audit && npm run survey:check && npm run redemption:check && npm run loadtest:report:check && npm run test",
    "i18n:build": "node scripts/i18n/build.ts",
    "i18n:check": "node scripts/i18n/check.ts",
    "dev:i18n": "node --watch-path=src/i18n/messages scripts/i18n/build.ts",
    "i18n:inventory": "node scripts/i18n/inventory.ts",
    "i18n:inventory:check": "node scripts/i18n/inventory.ts --check",
    "i18n:audit": "node scripts/i18n/audit-strings.ts",
    "i18n:export": "node scripts/i18n/export.ts",
    "i18n:import": "node scripts/i18n/import.ts",
    "i18n:import-source": "node scripts/i18n/import-source.ts",
    "survey:check": "node scripts/survey/check.ts",
    "redemption:check": "node scripts/redemption/check.ts",
    "loadtest:report": "node scripts/loadtest/report.ts",
    "loadtest:report:check": "node scripts/loadtest/report.ts --check",
    "check:docker-context": "docker build --pull=false --no-cache --progress=plain --target context-check .",
    "docs:screenshots": "node scripts/docs/screenshots.ts",
    "brand:build": "node scripts/brand/build.ts",
    "qr:urls": "node scripts/qr/urls.ts",
    "report": "node scripts/report/build.ts"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": false
  }
}
