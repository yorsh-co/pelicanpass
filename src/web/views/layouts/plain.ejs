<!doctype html>
<html lang="<%= locale %>" data-date-locale="<%= dateLocale %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>

  <%# Keeps the browser chrome on the same palette as the page.

      A page that paints its own surface rather than --canvas passes `themeColor`
      and gets one unconditional value, because such a surface is the same in
      both themes — pages/landing.css is on --brand-backdrop, which
      base/variables.css exempts from the light-dark() rule for that reason.

      These are raw literals because a meta tag cannot read a custom property.
      They shadow --canvas and the backdrop's top edge; a palette change has
      to come through here too. -%>
  <% if (locals.themeColor) { %>
  <meta name="theme-color" content="<%= locals.themeColor %>" />
  <% } else { %>
  <meta name="theme-color" content="#fafafc" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0a11" media="(prefers-color-scheme: dark)" />
  <% } %>

  <!-- favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/images/icon/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/icon/favicon-32x32.png">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/images/icon/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials">

  <%#
    The brand backdrop, fetched during HTML parse rather than after layout — it
    is a CSS background, so the preload scanner cannot see it, and without this
    it cannot start until main.css is down, parsed and laid out.

    Behind the same `themeColor` guard as the meta tag above, and for the same
    reason: that local marks a page painting its own surface rather than
    --canvas, which on this layout means the landing curtain and nothing else.
    Privacy, terms, the error page and /admin/login share this layout on plain
    canvas and must not be made to fetch a backdrop they never show.
  -%>
  <% if (locals.themeColor) { %>
  <link
    rel="preload"
    as="image"
    href="/assets/images/bg/bg.webp"
    type="image/webp"
    fetchpriority="high"
  />
  <% } %>

  <!-- global styles -->
  <link rel="stylesheet" href="/css/dist/main.css" />

  <!-- stored theme, applied before first paint. These pages carry no toggle of
       their own, but must honour a choice made on the check-in flow. -->
  <%- include('../partials/theme-boot') %>

  <!-- page-specific styles -->
  <%- defineContent('styles') %>
</head>
<%# `locals.` rather than a bare `audience`: privacy, terms and the error page
    share this layout without passing the local, and EJS throws on an undeclared
    name — partials/footer.ejs carries the same guard for the same reason.

    The attribute no longer drives any styling — one wordmark serves every
    audience now — but it stays as the surface's own record of who the page was
    rendered for, which the check-in bundle also writes back onto `body`. -%>
<body class="plain-page" data-audience="<%= locals.audience || '' %>">

  <div class="plain-wrapper">
    <%- body %>

    <%- include('../partials/footer') %>
  </div>

  <!-- global scripts. The only script these pages load: the footer's theme
       toggle would otherwise render here and do nothing. -->
  <script type="module" src="/js/theme/theme.js"></script>

  <!-- page-specific scripts -->
  <%- defineContent('scripts') %>
</body>
</html>
