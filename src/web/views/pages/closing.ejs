<%# i18n: landing %>
<%# The post-event page, drawn once EVENT_CLOSES_AT has passed by
    middleware/landing.middleware.ts and by the standalone fallback, which keeps
    serving it after the production host is torn down.

    layouts/plain for the reason given over pages/landing.ejs, and no script at
    all: there is nothing left to count down or open. %>
<main class="landing">
  <div class="landing-content">
    <img class="landing-mark" src="/assets/images/logo/mark.svg" alt="" />
    <h1 class="landing-title"><%= copy.closedTitle() %></h1>
    <p class="landing-lede"><%= copy.closedBody() %></p>
  </div>

  <%# The boot screen's lettering, at the boot screen's size, in flow as on
      pages/landing.ejs. %>
  <img
    class="boot-lettering"
    src="/assets/images/logo/wordmark-two-tone.svg"
    alt="<%= chrome.wordmarkAlt() %>"
  />
</main>

<%# Asset block last, for the reason spelled out in pages/error.ejs. %>
<%- contentFor('styles') %>
<link rel="stylesheet" href="/css/dist/pages/landing.css" />
