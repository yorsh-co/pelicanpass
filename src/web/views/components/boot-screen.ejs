<div id="app-boot" data-main="boot-screen" class="app-boot show">
  <div class="boot-content">
    <div id="boot-motif-right">
      <img
        class="motif"
        src="/assets/images/motifs/star-sm.svg"
        alt=""
      />
    </div>
    <div id="boot-motif-left">
      <img
        class="motif"
        src="/assets/images/motifs/star-sm.svg"
        alt=""
      />
    </div>
    <div id="boot-motif-centre">
      <img
        class="motif"
        src="/assets/images/motifs/star-with-discs.svg"
        alt=""
      />
    </div>
    <div class="logo">
      <img
        class="boot-wordmark"
        src="/assets/images/logo/wordmark-primary.svg"
        alt="<%= chrome.wordmarkAlt() %>"
      />
    </div>
  </div>
</div>
